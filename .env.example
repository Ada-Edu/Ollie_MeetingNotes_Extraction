# Supabase (local dev, run by `supabase start`)
#
# Auth keys are NOT committed here: newer Supabase CLIs generate per-instance
# signing keys, so the anon/service_role values differ on every machine.
# `make up` reads the live keys from `supabase start` and injects them
# automatically (see scripts/supabase-env.sh) -- you do NOT need to fill these in.
# They only matter if you bypass make and run `docker compose up` directly, in
# which case run `make supabase-status` and paste the real values here.
#
# Two URLs intentionally differ by run context:
#   SUPABASE_URL       -> used by the Temporal worker, which runs INSIDE Docker and
#                         reaches the host-bound Supabase via host.docker.internal.
#   VITE_SUPABASE_URL  -> used by the frontend, which runs in the browser on the HOST.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=injected-by-make-up
SUPABASE_SERVICE_ROLE_KEY=injected-by-make-up

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=main

# Frontend (browser on the host -> localhost)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=injected-by-make-up
VITE_API_URL=http://localhost:54321/functions/v1

# AI Model Configuration (for meeting notes extraction)
# Choose: azure or bedrock
MODEL_PROVIDER=azure

# Azure OpenAI (if MODEL_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# AWS Bedrock (if MODEL_PROVIDER=bedrock)
# Two authentication methods supported:

# Method 1: AWS Bearer Token (recommended for managed Bedrock services)
AWS_REGION=af-south-1
AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Method 2: AWS IAM Credentials (standard AWS Bedrock)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Available inference profiles (use these instead of direct model IDs):
# - global.anthropic.claude-sonnet-4-6 (Claude Sonnet 4.6 - tested)
# - global.anthropic.claude-opus-4-5-20251101-v1:0 (Claude Opus 4.5)
# - us.anthropic.claude-3-5-sonnet-20240620-v1:0 (Claude 3.5 Sonnet, US-only)
# - eu.anthropic.claude-3-5-sonnet-20240620-v1:0 (Claude 3.5 Sonnet, EU-only)
